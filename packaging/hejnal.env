# Settings for the Hejnal systemd service. Keep this file readable by root only.
# Uncomment what you use.

# Extra flags for `hejnal run`, for example the fix-list language and an exit
# status for new findings:
#HEJNAL_ARGS=-lang pl -fail-on high

# Slack, Mattermost or Rocket.Chat webhook:
#HEJNAL_WEBHOOK=
# Microsoft Teams Workflows webhook:
#HEJNAL_TEAMS_WEBHOOK=
# Email (Hejnal refuses to send unencrypted):
#HEJNAL_EMAIL_TO=
#HEJNAL_SMTP_HOST=
#HEJNAL_SMTP_PORT=587
#HEJNAL_SMTP_USER=
#HEJNAL_SMTP_PASSWORD=
#HEJNAL_SMTP_FROM=

# A free NVD API key makes version checks about ten times faster:
#HEJNAL_NVD_API_KEY=
